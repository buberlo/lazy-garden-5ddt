# Lazy Garden — environment example
# Copy this file to .env.local and adjust values as needed.
# SvelteKit loads .env, .env.local, and .env.[mode]. Variables prefixed with PUBLIC_ are exposed to the browser.

# --- App ---------------------------------------------------------------
# Public base URL used for share links and snapshot URLs.
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_APP_NAME=Lazy Garden
PUBLIC_GARDEN_TTL_HOURS=24

# --- Ollama / AI loop ---------------------------------------------------
# Local Ollama server. For a remote Ollama instance, set host to that URL.
OLLAMA_HOST=http://localhost:11434
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=llama3.2:3b
OLLAMA_FALLBACK_MODEL=phi3:mini
OLLAMA_CONTEXT_LENGTH=512
OLLAMA_TEMPERATURE=0.7
OLLAMA_MAX_TOKENS=160
# Keep the core AI loop under 10 seconds.
OLLAMA_TIMEOUT_MS=9000

# If the browser calls Ollama directly, expose the host to the client:
# PUBLIC_OLLAMA_HOST=http://localhost:11434

# --- 24-hour TTL --------------------------------------------------------
# All prompts, responses, and growth expire after this many hours.
GARDEN_TTL_HOURS=24
# How often the server checks for expired garden state.
GARDEN_TTL_CHECK_MS=60000

# --- Snapshots / sharing ------------------------------------------------
# Short prefix used in exported snapshot URLs.
PUBLIC_SNAPSHOT_PREFIX=lg
SNAPSHOT_VERSION=1
SNAPSHOT_MAX_BYTES=65536
# Optional secret for signed/verified snapshots.
# SNAPSHOT_SECRET=replace-with-a-long-random-string

# --- Optional persistence -----------------------------------------------
# Zero-setup default uses in-memory or local JSON; uncomment to enable SQLite.
# DATABASE_URL=file:./data/lazy-garden.sqlite
# SESSION_SECRET=replace-with-a-long-random-string
# NODE_ENV=development
